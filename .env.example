# =============================================================
# .env.example — Controle TCU · AFCE
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env no Git.
# =============================================================

# ----- Supabase -----
# Encontre estas chaves em: https://app.supabase.com
# → Seu projeto → Settings → API
#
# URL pública do seu projeto Supabase (ex: https://xyzxyzxyz.supabase.co)
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co

# Chave anônima pública (segura para uso no front-end)
# NÃO use a service_role key no front-end!
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...SUA_ANON_KEY_AQUI

# ----- Como usar no HTML -----
# No arquivo Controle_TCU.html, localize as constantes:
#   const SUPABASE_URL  = 'https://SEU_PROJECT_REF.supabase.co';
#   const SUPABASE_ANON_KEY = 'eyJ...';
# e substitua pelos valores reais do seu projeto Supabase.
#
# Em produção no Netlify:
# → Site settings → Environment variables → Add variable
# (as variáveis são expostas via window.__ENV__ pelo snippet no HTML)
